FROM golang:1.25-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Build the socket server (assumes main in socket/server)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /socket-server ./socket/server

FROM alpine:3.18
RUN apk add --no-cache ca-certificates
WORKDIR /app
RUN mkdir -p /app/data

COPY --from=builder /socket-server /app/socket-server

ENV AMQP_URL="amqp://guest:guest@rabbitmq:5672/"
ENV STATS_PATH="/app/data/stats.json"
ENV TCP_ADDR=":9000"

EXPOSE 9000

ENTRYPOINT ["/app/socket-server"]
